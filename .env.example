# Copy this file to `.env` and fill in the values. NEVER commit `.env`.

# --- PostgreSQL (used by docker compose) ---
POSTGRES_USER=docint
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=docint

# --- Application ---
APP_ENV=development            # development | test | production
# REQUIRED. At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# The first admin account is created at startup if no admin exists yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
# Browsers that may call the API (comma-separated JSON list), e.g. ["http://localhost:3000"]
CORS_ORIGINS=["http://localhost:3000"]
MAX_UPLOAD_MB=200

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- AI ---
# heuristic = free, offline, rule-based. gemini = Google AI Studio (free tier has rate limits).
LLM_PROVIDER=heuristic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_REQUESTS_PER_MINUTE=10

# --- Workers ---
WORKER_CONCURRENCY=2
STALLED_AFTER_MINUTES=15
